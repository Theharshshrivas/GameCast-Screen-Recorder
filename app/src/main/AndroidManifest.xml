
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:label="GameCast Screen Recorder"
        android:icon="@mipmap/gamecast_app_icon"
        android:roundIcon="@mipmap/gamecast_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StorageDashboardActivity"
            android:exported="true"
            android:label="GameCast Tools" />

        <activity
            android:name=".ScreenshotActivity"
            android:exported="true"
            android:label="GameCast Screenshots" />

        <activity
            android:name=".RecycleBinActivity"
            android:exported="false"
            android:label="GameCast Recycle Bin" />

        <activity
            android:name=".FloatingControlsActivity"
            android:exported="true"
            android:label="GameCast Floating Controls" />

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <service
            android:name=".ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".FloatingControlsService"
            android:exported="false" />

    </application>

</manifest>
